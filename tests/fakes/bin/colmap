#!/usr/bin/env python3
"""Stand-in for the `colmap` CLI used by the integration tests.

Prints the same kinds of progress lines as real COLMAP and writes the minimal outputs
the pipeline reads. Behaviour knobs (environment variables):
  FAKE_COLMAP_REGISTER  fraction of frames the mapper registers (default 1.0)
  FAKE_COLMAP_DELAY     seconds per progress line (default 0.001)
  FAKE_COLMAP_GLOBAL    "0": pretend to be COLMAP 3.x (no global_mapper)
  FAKE_COLMAP_GLOBAL_REGISTER  like FAKE_COLMAP_REGISTER, for the global mapper only
  FAKE_COLMAP_FAIL      a command name: that command fails
  FAKE_COLMAP_POSES     "full" or "gap": write real camera poses walking around the object
                        (all the way round, or skipping a 130-degree side); "wall": the same gap,
                        with a wall standing on that side (in points3D.bin); default: none
"""
import glob
import math
import os
import shutil
import sys
import time

cmd, args = sys.argv[1], sys.argv[2:]
if cmd == "help":
    print("Usage:\n  colmap [command] [options]\n\nAvailable commands:\n  bundle_adjuster\n  feature_extractor\n"
          + ("  global_mapper\n" if os.environ.get("FAKE_COLMAP_GLOBAL", "1") == "1" else "")
          + "  mapper\n  point_triangulator\n  sequential_matcher")
    sys.exit(0)


def opt(k):
    return args[args.index(k) + 1] if k in args else None


if "-h" in args:
    print("  --SiftExtraction.use_gpu arg (=1)")
    sys.exit(0)
DELAY = float(os.environ.get("FAKE_COLMAP_DELAY", "0.001"))
if os.environ.get("FAKE_COLMAP_FAIL") == cmd:
    print(f"E1011 {cmd}: failed (FAKE_COLMAP_FAIL)", flush=True)
    sys.exit(1)
REGISTER = float(os.environ.get("FAKE_COLMAP_REGISTER", "1.0"))


def images():
    p = opt("--image_path") or os.path.join(os.path.dirname(opt("--database_path")), "images")
    return sorted(os.path.basename(x) for x in glob.glob(os.path.join(p, "*.jpg")))


def write_poses(path, names, kind):
    """images.bin with cameras circling the origin at three heights, looking at it (y down)."""
    import struct
    sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), ".."))
    from plyfile import _rot_to_quat
    span = 230.0 if kind in ("gap", "wall") else 360.0
    out = bytearray(struct.pack("<Q", len(names)))
    for i, name in enumerate(names):
        a = math.radians(span * i / max(1, len(names)))
        h = (-0.4, 0.0, 0.5)[i % 3]
        c = (3 * math.cos(a), -h, 3 * math.sin(a))
        z = [-v for v in c]
        nz = math.sqrt(sum(v * v for v in z)); z = [v / nz for v in z]
        down = (0.0, 1.0, 0.0)
        x = [down[1] * z[2] - down[2] * z[1], down[2] * z[0] - down[0] * z[2], down[0] * z[1] - down[1] * z[0]]
        nx = math.sqrt(sum(v * v for v in x)); x = [v / nx for v in x]
        y = [z[1] * x[2] - z[2] * x[1], z[2] * x[0] - z[0] * x[2], z[0] * x[1] - z[1] * x[0]]
        R = [x, y, z]
        t = [-sum(R[r][k] * c[k] for k in range(3)) for r in range(3)]
        out += struct.pack("<I7dI", i + 1, *_rot_to_quat(R), *t, 1) + name.encode() + b"\0" + struct.pack("<Q", 0)
    open(path, "wb").write(bytes(out))


def write_points(path, wall):
    """points3D.bin: the object (a small cluster at the origin), the floor under it, and with
    wall=True a wall 2 units away on the side the cameras skipped (230-360 degrees)."""
    import random
    import struct
    rnd = random.Random(1)
    pts = [(rnd.uniform(-.4, .4), rnd.uniform(-.4, .4), rnd.uniform(-.4, .4)) for _ in range(300)]
    pts += [(rnd.uniform(-4, 4), 0.5, rnd.uniform(-4, 4)) for _ in range(600)]           # floor (y down)
    if wall:
        mid = math.radians(295)
        n, t = (math.cos(mid), math.sin(mid)), (-math.sin(mid), math.cos(mid))
        for _ in range(800):
            s, h = rnd.uniform(-3, 3), rnd.uniform(-1.5, 0.5)
            pts.append((2.2 * n[0] + s * t[0], h, 2.2 * n[1] + s * t[1]))
    out = bytearray(struct.pack("<Q", len(pts)))
    for i, (x, y, z) in enumerate(pts):
        out += struct.pack("<Q3d3BdQ", i + 1, x, y, z, 128, 128, 128, 0.5, 0)
    open(path, "wb").write(bytes(out))


if cmd == "feature_extractor":
    import sqlite3
    db = opt("--database_path")
    if os.path.exists(db):
        os.unlink(db)
    with sqlite3.connect(db) as con:          # like COLMAP: ids from 1, in file name order
        con.execute("CREATE TABLE cameras (camera_id INTEGER PRIMARY KEY, model INTEGER, params TEXT)")
        con.execute("CREATE TABLE images (image_id INTEGER PRIMARY KEY, name TEXT, camera_id INTEGER)")
        con.execute("INSERT INTO cameras VALUES (1, 1, ?)", (opt("--ImageReader.camera_params") or "",))
        con.executemany("INSERT INTO images VALUES (?, ?, 1)", [(i + 1, nm) for i, nm in enumerate(images())])
    n = len(images())
    for i in range(1, n + 1):
        print(f"I1011 feature_extraction.cc:257] Processed file [{i}/{n}]")
        print("I1011 feature_extraction.cc:260]   Features:        4000", flush=True)
        time.sleep(DELAY)
elif cmd == "sequential_matcher":
    n = len(images())
    for i in range(1, n + 1):
        print(f"I1011 pairing.cc:180] Processing image [{i}/{n}]", flush=True)
        time.sleep(DELAY)
elif cmd == "matches_importer":
    for i in range(1, 4):
        print(f"I1011 pairing.cc:301] Processing block [{i}/3]", flush=True)
        time.sleep(DELAY)
elif cmd == "exhaustive_matcher":
    b = max(1, math.ceil(len(images()) / 50))
    for x in range(1, b + 1):
        for y in range(1, b + 1):
            print(f"I1011 pairing.cc:214] Processing block [{x}/{b}, {y}/{b}]", flush=True)
            time.sleep(DELAY)
elif cmd in ("mapper", "global_mapper"):
    names, out = images(), opt("--output_path")
    reg = float(os.environ.get("FAKE_COLMAP_GLOBAL_REGISTER", REGISTER)) if cmd == "global_mapper" else REGISTER
    keep = names[: int(round(len(names) * reg))]
    # a gap in the middle when not everything registers, like a real broken track
    if reg < 1.0:
        k = len(names) - len(keep)
        mid = len(names) // 2
        keep = names[:mid - k // 2] + names[mid - k // 2 + k:]
    if cmd == "mapper":
        for i, _ in enumerate(keep, 1):
            print(f"I1011 incremental_mapper.cc:620] Registering image #{i} ({i})", flush=True)
            time.sleep(DELAY)
    else:                                      # COLMAP 4's global mapper reports stages, not images
        for line in ["==============================\nRunning rotation averaging\n==============================",
                     "I1011 global_mapper.cc:563] Rotation averaging done in 0.4 seconds",
                     "Running track establishment", "Running global positioning",
                     "Running iterative bundle adjustment"] + \
                    [f"I1011 global_mapper.cc:395] Global bundle adjustment iteration {k} / 3" for k in (1, 2, 3)] + \
                    ["Running iterative retriangulation and refinement",
                     "I1011 global_pipeline.cc:156] Reconstruction done in 1.2 seconds"]:
            print(line, flush=True)
            time.sleep(DELAY * 10)
    os.makedirs(os.path.join(out, "0"))
    open(os.path.join(out, "0", "registered.txt"), "w").write("\n".join(keep))
    os.makedirs(os.path.join(out, "1"))                      # a tiny second model, as real COLMAP often makes
    open(os.path.join(out, "1", "registered.txt"), "w").write("\n".join(names[:3]))
elif cmd == "point_triangulator":
    import sqlite3
    src, out = opt("--input_path"), opt("--output_path")
    with sqlite3.connect(opt("--database_path")) as con:
        db_ids = {name: iid for iid, name in con.execute("SELECT image_id, name FROM images")}
    sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), ".."))
    import struct
    data = open(os.path.join(src, "images.bin"), "rb").read()
    n, = struct.unpack_from("<Q", data, 0)
    o = 8
    for _ in range(n):                         # the model's image ids must be the database's
        iid, = struct.unpack_from("<I", data, o)
        o += struct.calcsize("<I7dI")
        end = data.index(b"\0", o)
        name = data[o:end].decode()
        o = end + 1 + 8
        if db_ids.get(name) != iid:
            sys.exit(f"E1011 point_triangulator: image {name} has id {iid} in the model, {db_ids.get(name)} in the database")
    for i in range(1, n + 1):
        print(f"I1011 point_triangulator.cc:90] Triangulating image #{i} ({i})", flush=True)
        time.sleep(DELAY)
    for b in ("cameras.bin", "images.bin"):
        shutil.copy(os.path.join(src, b), os.path.join(out, b))
    write_points(os.path.join(out, "points3D.bin"), False)
elif cmd == "bundle_adjuster":
    src, out = opt("--input_path"), opt("--output_path")
    print("I1011 bundle_adjustment.cc:40] Bundle adjustment report", flush=True)
    for b in ("cameras.bin", "images.bin", "points3D.bin"):
        shutil.copy(os.path.join(src, b), os.path.join(out, b))
elif cmd == "model_converter":
    reg = open(os.path.join(opt("--input_path"), "registered.txt")).read().split()
    with open(os.path.join(opt("--output_path"), "images.txt"), "w") as f:
        f.write("# Image list with two lines of data per image:\n")
        for i, name in enumerate(reg, 1):
            f.write(f"{i} 1 0 0 0 0 0 0 1 {name}\n\n")       # empty 2D-points line
elif cmd == "model_analyzer":
    path = opt("--path")
    # the pipeline moves the undistorted model into sparse/0; the list stays one level up
    reg_file = next((f for f in (os.path.join(path, "registered.txt"), os.path.join(path, "..", "registered.txt"))
                     if os.path.exists(f)), None)
    n = len(open(reg_file).read().split()) if reg_file else 0
    print(f"I1011 model.cc:12] Registered images: {n}\nI1011 model.cc:13] Points: {n * 240}\n"
          "I1011 model.cc:14] Mean reprojection error: 0.61px")
elif cmd == "image_undistorter":
    reg = open(os.path.join(opt("--input_path"), "registered.txt")).read().split()
    out = opt("--output_path")
    os.makedirs(os.path.join(out, "images"), exist_ok=True)
    os.makedirs(os.path.join(out, "sparse"), exist_ok=True)
    src = opt("--image_path")
    for i, name in enumerate(reg, 1):
        print(f"I1011 undistortion.cc:150] Undistorting image [{i}/{len(reg)}]", flush=True)
        shutil.copy(os.path.join(src, name), os.path.join(out, "images", name))
        time.sleep(DELAY)
    for b in ("cameras", "images", "points3D"):
        open(os.path.join(out, "sparse", f"{b}.bin"), "w").close()
    if os.environ.get("FAKE_COLMAP_POSES"):
        write_poses(os.path.join(out, "sparse", "images.bin"), reg, os.environ["FAKE_COLMAP_POSES"])
        write_points(os.path.join(out, "sparse", "points3D.bin"), os.environ["FAKE_COLMAP_POSES"] == "wall")
    open(os.path.join(out, "sparse", "registered.txt"), "w").write("\n".join(reg))
else:
    sys.exit(f"fake colmap: unknown command {cmd}")
